# HTTPS für MAKE OS — Zertifikat holt Caddy selbst, sobald die Domain auf den Server zeigt.
# Sicherheits-Kopfzeilen (25.09., „höchste Stufe“): nur HTTPS (HSTS), Kamera/Mikrofon nur
# für MAKE OS selbst, keine Verrate-Kopfzeilen. Content-Security-Policy und X-Frame-Options
# setzt seit 26.09. die App selbst (next.config.mjs, je Pfad: der Altbestand /finanz-dashboard.html
# darf im eigenen Rahmen laufen) — Caddy würde sie hier überschreiben, deshalb stehen sie nicht mehr hier.
# Referrer-Policy und Permissions-Policy (Upload U1 N1, 29.09.): nur noch als Vorgabe („?“ = nur, wenn die App keine
# setzt) — die öffentliche Buchungsseite (/buchen…, /api/buchung…) hat eigene, strengere Werte in next.config.mjs
# (`no-referrer`: die Status-Adresse trägt das Token im Fragment; keine Kamera/Mikrofon). Früher überschrieb Caddy sie
# mit den allgemeinen. Für diese Pfade setzt Caddy dieselben strengen Werte zusätzlich ausdrücklich.
#
# Domain makeinnovation.de (01.10., DEPLOY.md › „Domain makeinnovation.de“): Die Software antwortet zusätzlich unter
# app.makeinnovation.de — das steht NICHT hier, sondern in der Server-.env: MAKE_OS_DOMAIN darf eine kommagetrennte
# Liste sein, z. B. MAKE_OS_DOMAIN="app.makeinnovation.de, 2-28-108-162.sslip.io" (sslip bleibt Rückfall). Eine Adresse
# zusätzlich hier einzutragen, die schon in MAKE_OS_DOMAIN steht, ließe Caddy nicht starten (doppelte Site-Adresse).
{$MAKE_OS_DOMAIN} {
	encode zstd gzip
	# Zugang & Schlüssel härten (05.10.): den internen Next-Kopf, mit dem sich die Middleware überspringen ließe
	# (CVE-2025-29927, in Next 15.5 behoben — hier zusätzlich), nie von außen annehmen.
	request_header -x-middleware-subrequest
	# Marke „kam über den Vorbau“: der Dienstschlüssel MAKE_OS_KEY gilt nur OHNE sie (lib/zugang/intern.ts) — ersetzt
	# jeden Wert, den ein Aufrufer selbst schickt.
	request_header X-Make-Vorbau "1"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		?Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
		-X-Powered-By
	}
	@buchung path /buchen /buchen/* /api/buchung /api/buchung/*
	header @buchung {
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	reverse_proxy app:3000
}

# ─── makeinnovation.de + www — die Landingpage der MAKE Innovation GmbH ──────────────────────
# AKTIV seit 01.10. als VORSCHAU (Kevin: „nur für mich und Malin, wir bewerben das noch nicht“): Suchmaschinen
# bekommen `X-Robots-Tag: noindex, nofollow` und `robots.txt` (Disallow). Erst wenn die Seite beworben wird und
# `node website/pruefen.mjs` „freigabefähig“ meldet: die X-Robots-Tag-Zeile entfernen und website/robots.txt öffnen.
# HSTS hier bewusst OHNE includeSubDomains (Mail-Autokonfiguration des Domain-Anbieters).
# ▼ FREIGABE-FASSUNG (aktiv) — tests/caddy-buchung-koepfe.test.ts lässt offene Platzhalter nur mit noindex + robots.txt zu.
(landingpage_koepfe) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}
}
www.makeinnovation.de {
	header -Server
	redir https://makeinnovation.de{uri} 301
}
makeinnovation.de {
	root * /srv/website
	encode zstd gzip
	import landingpage_koepfe
	# Arbeitsdateien im Ordner werden nie ausgeliefert (wie NICHT_OEFFENTLICH in website/pruefen.mjs; *.md/*.mjs in jeder Tiefe).
	@intern path /LIESMICH.md /pruefen.mjs /logo-entwuerfe.html /assets/logo/LOGO.md *.md *.mjs
	respond @intern 404
	# Caching: Seiten immer frisch nachfragen (ETag/Last-Modified von file_server), Schriften lange, Stile/Skript/Logo einen Tag.
	@seiten path / /*.html
	header @seiten Cache-Control "no-cache"
	@schriften path /assets/fonts/*
	header @schriften Cache-Control "public, max-age=2592000, immutable"
	@stile path /css/* /js/* /favicon.svg /assets/logo/*
	header @stile Cache-Control "public, max-age=86400"
	file_server {
		hide LIESMICH.md pruefen.mjs logo-entwuerfe.html LOGO.md
	}
	# Unbekannte Adressen: eigene 404-Seite mit denselben Köpfen (der Fehlerweg ist eine eigene Route-Kette).
	handle_errors {
		root * /srv/website
		import landingpage_koepfe
		rewrite * /404.html
		file_server
	}
}
# ▲ FREIGABE-FASSUNG

# ─── fokusinnovation.de + www — Event-Seite „Fokus Innovation“ (Ordner fokus/, Kevin 04.10.) ─────────────────────
# VORSCHAU wie makeinnovation.de: noindex über landingpage_koepfe + fokus/robots.txt (Disallow). Erst wenn beworben wird und
# `node fokus/pruefen.mjs` „freigabefähig“ meldet: noindex entfernen (eigene Kopf-Gruppe) und fokus/robots.txt öffnen.
www.fokusinnovation.de {
	header -Server
	redir https://fokusinnovation.de{uri} 301
}
fokusinnovation.de {
	root * /srv/fokus
	encode zstd gzip
	import landingpage_koepfe
	# Arbeitsdateien werden nie ausgeliefert (wie NICHT_OEFFENTLICH in fokus/pruefen.mjs).
	@intern path /LIESMICH.md /pruefen.mjs *.md *.mjs
	respond @intern 404
	@seiten path / /*.html
	header @seiten Cache-Control "no-cache"
	@schriften path /assets/fonts/*
	header @schriften Cache-Control "public, max-age=2592000, immutable"
	@stile path /css/* /js/* /favicon.svg /assets/logo/* /assets/film/*
	header @stile Cache-Control "public, max-age=86400"
	file_server {
		hide LIESMICH.md pruefen.mjs
	}
	handle_errors {
		root * /srv/fokus
		import landingpage_koepfe
		rewrite * /404.html
		file_server
	}
}
