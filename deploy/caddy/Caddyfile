# ▲ FREIGABE-FASSUNG

# ─── fokusinnovation.de + www — die Website von Fokus Innovation (Ordner fokusinnovation/, Kevin 26.10.: „online bringen“) ───
# VORSCHAU (Kevin 26.10.: „erst Vorschau“, „nur für intern gerade“): erreichbar für jeden mit Link, aber Suchmaschinen bekommen
# `X-Robots-Tag: noindex, nofollow`, jede Seite trägt <meta name="robots" content="noindex"> und robots.txt sperrt alles.
# Freischalten: die X-Robots-Tag-Zeile unten entfernen und im Generator (prototype/fokus-innovation/bauen.mjs) noindex und robots.txt öffnen.
# Der Ordner ist gebaut (statisch, eigene Schrift, keine fremden Quellen) — Quelle: prototype/fokus-innovation/ auf dem Zweig innovations-check.
# Der frühere Ordner fokus/ (Event-Seite) wird nicht mehr ausgeliefert.
# Suche (27.10.): sitemap.xml, llms.txt und llms-full.txt (für KI-Suchen) liegen im Ordner; Vorschaubilder und Icons unter /assets/bild/.
# Die strukturierten Daten stehen als JSON-LD-Datenblock in den Seiten — die CSP lässt ihn zu, weil er nicht ausgeführt wird.
(fokus_koepfe) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}
}
www.fokusinnovation.de {
	header -Server
	redir https://fokusinnovation.de{uri} 301
}
fokusinnovation.de {
	encode zstd gzip
	# Wie im App-Block: den internen Next-Kopf nie annehmen, Marke „kam über den Vorbau“ setzen (lib/zugang/intern.ts).
	request_header -x-middleware-subrequest
	request_header X-Make-Vorbau "1"
	# Welle 3 (29.10.): Innovations-Check und Terminbuchung laufen in MAKE OS (beide kommen dort ausgeschaltet bzw. ohne Seite, bis Kevin sie
	# einschaltet). Nur diese Pfade gehen an die App; die App setzt für sie ihre eigenen strengen Köpfe (next.config.mjs, `buchung`).
	# /_next/* sind die Skripte und Stile dieser Seiten, /schriften/* die Schrift des Checks.
	# 30.10.: die Newsletter-Anmeldung (/newsletter, POST /api/newsletter — kommt ausgeschaltet; das Token steht nur im Fragment).
	# 31.10.: Unterlagen per E-Mail anfordern (GET/POST /api/unterlage, Download-Link /api/unterlage/laden — ohne Website-Absender aus).
	@app path /check /api/check /newsletter /api/newsletter /api/unterlage /api/unterlage/* /buchen /buchen/* /api/buchung /api/buchung/* /_next/* /schriften/*
	handle @app {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			-Server
			-X-Powered-By
		}
		reverse_proxy app:3000
	}
	# ── Kontaktformular (31.10., Website-Anbau) — eigener Block: genau /anfrage und POST /api/anfrage an die App (kommt AUS; dieselben Köpfe wie @app).
	#    Die statische Seite /kontakt/ der Website bleibt; sie kann auf /anfrage verlinken. Nie /api/anfrage/* (die Verwaltung bleibt intern).
	@kontaktformular path /anfrage /api/anfrage
	handle @kontaktformular {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			-Server
			-X-Powered-By
		}
		reverse_proxy app:3000
	}
	# ── Ende Kontaktformular ──
	# Kostenlos (30.10.): die frühere Übersicht /wissen/ heißt jetzt /kostenlos/ — die Ratgeber behalten ihre Adressen /wissen/<id>/.
	@altwissen path /wissen /wissen/ /wissen/index.html
	redir @altwissen /kostenlos/ 301
	# Events (30.10., Kevin: „Das sind Events, keine Abende“): die frühere Seite /abend/ heißt jetzt /events/.
	@altabend path /abend /abend/ /abend/index.html
	redir @altabend /events/ 301
	handle {
		root * /srv/fokusinnovation
		import fokus_koepfe
		# Arbeitsdateien werden nie ausgeliefert.
		@intern path *.md *.mjs
		respond @intern 404
		# Caching: Seiten immer frisch nachfragen, Schrift lange, Stile, Skripte und Bilder (tragen ?v=…) einen Tag.
		@seiten path / */ *.html
		header @seiten Cache-Control "no-cache"
		@schriften path /assets/schriften/*
		header @schriften Cache-Control "public, max-age=2592000, immutable"
		@stile path /css/* /js/* /assets/zeichen.svg /assets/bild/* /favicon.ico
		header @stile Cache-Control "public, max-age=86400"
		file_server {
			hide *.md
		}
	}
	handle_errors {
		root * /srv/fokusinnovation
		import fokus_koepfe
		rewrite * /404.html
		file_server
	}
}
