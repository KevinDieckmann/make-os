# ─── /srv/make-os/app/.env auf dem Server ── NIE ins Repo, nie in iCloud ───
# Neu erzeugen: openssl rand -hex 32
MAKE_OS_KEY=
SESSION_SECRET=
ANTHROPIC_API_KEY=
# Die Adresse, unter der ihr MAKE OS öffnet — und die Domain für Caddy
MAKE_OS_ADRESSE=https://DOMAIN
MAKE_OS_DOMAIN=DOMAIN
# Malins Cockpit (öffentliche Projektadresse und öffentlicher Schlüssel, für den Umzug)
MAKE_ORGA_URL=
MAKE_ORGA_KEY=
# Optional
TELEGRAM_BOT_TOKEN=
# iCloud-Kalender (app-spezifisches Passwort) — NICHT von Hand eintragen:
# ssh -t root@SERVER bash /srv/make-os/app/deploy/icloud-verbinden.sh
# ICLOUD_APPLE_ID=
# ICLOUD_APP_PASSWORT=
