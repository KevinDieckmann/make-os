# ─── /srv/make-os/app/.env auf dem Server ── NIE ins Repo, nie in iCloud ───
# Neu erzeugen: openssl rand -hex 32
MAKE_OS_KEY=
SESSION_SECRET=
# Head of IT (27.09.): eingeschränkter Schlüssel NUR für /api/hoi/* — derselbe Wert als GitHub-Secret MAKE_OS_KEY_HOI (Außenblick). openssl rand -hex 32
MAKE_OS_KEY_HOI=
ANTHROPIC_API_KEY=
# Die Adresse, unter der ihr MAKE OS öffnet — und die Domain für Caddy
MAKE_OS_ADRESSE=https://DOMAIN
MAKE_OS_DOMAIN=DOMAIN
# Malins Cockpit (öffentliche Projektadresse und öffentlicher Schlüssel, für den Umzug)
MAKE_ORGA_URL=
MAKE_ORGA_KEY=
# Optional
TELEGRAM_BOT_TOKEN=
# Brain (27.09.): lokale Embeddings (multilingual-e5-small, ~120 MB, lädt beim ersten Gebrauch). Auf 2 GB RAM knapp — bei Bedarf „aus“, dann nur Volltext-Index.
# Embeddings (Brain-Suche) bleiben auf Servern mit 1–2 CPUs von selbst aus (nur Volltext). Erzwingen: MAKE_OS_EMBEDDINGS=an · abschalten überall: aus
# MAKE_OS_EMBEDDINGS=aus
# iCloud-Kalender (app-spezifisches Passwort) — NICHT von Hand eintragen:
# ssh -t root@SERVER bash /srv/make-os/app/deploy/icloud-verbinden.sh
# ICLOUD_APPLE_ID=
# ICLOUD_APP_PASSWORT=
