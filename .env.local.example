# ─── MAKE OS — lokale Umgebungsvariablen ────────────────────────────────────
# Kopiere diese Datei zu ".env.local" (die ist gitignored) und trag deine Keys ein.
# Danach den Dev-Server neu starten.

# Zugangsschlüssel — PFLICHT: ohne ihn bleibt das System gesperrt (fail-closed).
# Erzeugen: openssl rand -hex 32. Damit wird auf /anmelden das ERSTE Konto (Inhaber) eingerichtet;
# danach dient er nur noch dem Dienstweg (Arbeiter, Bote) — nie im Browser eingeben.
MAKE_OS_KEY=hier-einen-langen-eigenen-schluessel-ausdenken

# Sitzungen der Konten werden mit diesem Geheimnis signiert. Fehlt es, gilt
# MAKE_OS_KEY. Ein eigener Wert ist besser: dann kann der Schlüssel wechseln,
# ohne dass alle abgemeldet werden.
# SESSION_SECRET=noch-eine-lange-zufaellige-zeichenkette

# Head of IT (27.09.): eingeschränkter Schlüssel, der NUR /api/hoi/* öffnet (Außenblick der GitHub-Aktion).
# Lokal nicht nötig. Auf dem Server: openssl rand -hex 32, derselbe Wert als GitHub-Secret MAKE_OS_KEY_HOI.
# MAKE_OS_KEY_HOI=

# ─── Adressen (24.09.) ──────────────────────────────────────────────────────
# Wo Menschen MAKE OS öffnen — z. B. die Tailscale-Adresse. Geht in die
# Einladungslinks und gilt als eigene Adresse beim Schutz gegen fremde Seiten.
# MAKE_OS_ADRESSE=https://macbook-air-von-kevin.tailXXXX.ts.net
# Wie der Server sich selbst erreicht (Standard: http://localhost:3001). Auf
# dem Server im Container z. B. http://localhost:3000.
# MAKE_OS_INTERN=http://localhost:3001

# ─── Malins Finanz-Cockpit (Umzug der Haushaltsfinanzen, 24.09.) ────────────
# Projekt-Adresse und ÖFFENTLICHER Schlüssel aus js/config.js ihres Cockpits.
# Nur für den Umzug gebraucht; ohne Anmeldung gibt Supabase nichts heraus.
# MAKE_ORGA_URL=https://<projekt>.supabase.co
# MAKE_ORGA_KEY=sb_publishable_...

# Kimmi (echte KI) — Anthropic API-Key von console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell (Default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# ─── Brain (27.09.) ─────────────────────────────────────────────────────────
# Volltext-Index (SQLite FTS5) liegt unter .data/brain-index.sqlite; lokale Embeddings (Modell-Cache ~/.cache/make-os/modelle).
# MAKE_OS_EMBEDDINGS=aus        # nur Volltext
# MAKE_OS_BRAIN_INDEX=aus       # gar kein Index (alte Dateisuche)
# MAKE_OS_MODELLE_DIR=~/.cache/make-os/modelle

# ─── Telegram — der Bote (Gesundheits-Takt aufs Handy) ─────────────────────
# In Telegram @BotFather anschreiben → /newbot → Namen vergeben → Token hierher.
# Danach in MAKE OS unter Gesundheit → Telegram einen Code holen und dem Bot
# senden als: /start CODE. Ohne Token bleibt der Bote aus, alles andere läuft.
# TELEGRAM_BOT_TOKEN=123456789:AAAA...

# ─── Microsoft 365 live (Schritt 2 — Azure App-Registrierung) ───────────────
# Aus Microsoft Entra → App-Registrierung. Erst nötig, wenn wir M365 live schalten.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=

# ─── Miro live (Single Source of Truth: Board Kevin & Frank) ────────────────
# Token aus Miro → Profileinstellungen → "Your apps" → Developer-App → REST-Token.
# Board-ID steht in der URL: miro.com/app/board/<ID>/
# MIRO_TOKEN=
# MIRO_BOARD_ID=uXjVH9M0tas=
